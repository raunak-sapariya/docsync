JWT_SECRET=change-me-change-me-change-me-please-32-bytes-minimum
ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./docsync.db
REDIS_URL=redis://localhost:6379/0

# local | azure | aws
STORAGE_PROVIDER=local

# Azure Blob Storage (only read if STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=docsync-snapshots

# AWS S3 (only read if STORAGE_PROVIDER=aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=docsync-snapshots

SENTRY_DSN=

# Comma-separated origins your frontend is served from
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# How often (seconds) an actively-edited document gets a durable snapshot
SNAPSHOT_INTERVAL_SECONDS=180

# How long (seconds) an empty document room is kept in memory before it's
# snapshotted and closed. Covers a page refresh, so reloading rejoins the same
# room instead of racing its teardown.
ROOM_GRACE_PERIOD_SECONDS=15

# Snapshot versions to keep per document; older ones are deleted. 0(keep all).
SNAPSHOT_RETENTION_COUNT=10
LOG_LEVEL=INFO
